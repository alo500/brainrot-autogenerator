# ─── Required: Claude API (script generation) ─────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...        # REPLACE THIS

# ─── Required: Replicate API (FLUX Schnell image generation) ──────────────────
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...          # REPLACE THIS

# ─── Optional: edge-tts voice override ───────────────────────────────────────
# Run `edge-tts --list-voices` to see all available voices.
# Good options: en-US-AndrewMultilingualNeural, en-US-GuyNeural, en-US-AriaNeural
# If not set, generator.py defaults to en-US-AndrewMultilingualNeural.
# TTS_VOICE=en-US-AndrewMultilingualNeural

# ─── Story channels (channel_gen / channel_post / channel_stats) ─────────────
# Where analytics-dashboard runs (plan + stats + post registry).
# DASHBOARD_URL=http://localhost:3100
# Better local script model than llama3 (ollama pull qwen2.5:14b), optional:
# OLLAMA_MODEL=llama3
# TikTok app from developers.tiktok.com (Login Kit Desktop + Content Posting API)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
